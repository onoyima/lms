APP_NAME="Exams Platform"   # server name only; what people see is set in Platform branding
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local database only. Create it in phpMyAdmin first: exams_platform, utf8mb4_unicode_ci
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=exams_platform
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Platform ───────────────────────────────────────────────
# Institution used when no address matches (single-institution / campus LAN install)
PLATFORM_DEFAULT_TENANT=     # short name of that institution; blank = the first institution added
# Word import needs Pandoc: https://pandoc.org/installing.html
# Windows example: PANDOC_PATH="C:\\Program Files\\Pandoc\\pandoc.exe"
PANDOC_PATH=pandoc
# Addresses the desktop app / SEB may use, LAN first then live URL (comma separated)
PLATFORM_CLIENT_ENDPOINTS=
# Password for the seeded admin accounts (otherwise one is generated and printed)
SEED_ADMIN_PASSWORD=
HEALTH_TOKEN=
BACKUP_PATH=
BACKUP_KEEP_DAYS=14
BACKUP_PASSPHRASE=
BACKUP_MYSQLDUMP=mysqldump
BACKUP_MYSQL=mysql

# Platform billing (the SaaS operator's own account). Leave empty to accept bank transfers only.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PLATFORM_BANK_DETAILS=
# Shared secret your mail service uses to sign bounce reports sent to /webhooks/mail
PLATFORM_MAIL_WEBHOOK_SECRET=
# Campus install: allow private campus addresses for institution mail servers and hall network checks. Set false on shared hosting.
PLATFORM_ALLOW_PRIVATE_TARGETS=true
# Optional Slack/Teams/Google Chat incoming webhook that also receives platform alerts
PLATFORM_ALERT_WEBHOOK=
# Other application servers the recovery drill checks, comma-separated (e.g. https://app2.campus.local)
PLATFORM_DR_PEERS=

# Portal bridge (Veritas University portal): sign-in with portal accounts and a read-only directory API.
# Runs beside the portal database; it refuses any database not on this computer and never writes to it.
# See docs/OPERATIONS.md section 18. Leave switched off where there is no portal database.
VUNA_BRIDGE_ENABLED=false
VUNA_BRIDGE_NAME="Veritas University portal"
VUNA_BRIDGE_ISSUER=
VUNA_DB_HOST=127.0.0.1
VUNA_DB_PORT=3306
VUNA_DB_DATABASE=
VUNA_DB_USERNAME=
VUNA_DB_PASSWORD=
# The portal database on another server (read-only). Off by default; give the bridge a SELECT-only user.
VUNA_DB_ALLOW_REMOTE=false
# Optional: CA certificate file to encrypt the connection to a remote database
VUNA_DB_SSL_CA=
# How many semesters before the running one to bring in as students' previous courses
VUNA_PREVIOUS_SEMESTERS=1
VUNA_BRIDGE_CLIENT_ID=veritas-exams-lms
VUNA_BRIDGE_CLIENT_SECRET=
VUNA_BRIDGE_REDIRECT_URIS=
VUNA_BRIDGE_LOGOUT_URIS=


# Upload screening (optional ClamAV daemon; built-in checks always run)
CLAMAV_SOCKET=
CLAMAV_FAIL_CLOSED=true

# Live classes (BigBlueButton). Servers are normally added in the platform console; these are optional.
BBB_URL=
BBB_SECRET=
BBB_CHECKSUM=sha256
# Optional: transcripts of class recordings (any OpenAI-style /v1/audio/transcriptions server, e.g. self-hosted faster-whisper)
TRANSCRIBE_URL=
TRANSCRIBE_KEY=
TRANSCRIBE_MODEL=Systran/faster-whisper-small
TRANSCRIBE_LANGUAGE=
# Optional: translation of transcripts (a LibreTranslate server)
TRANSLATE_URL=
TRANSLATE_KEY=

# Built-in meeting rooms (no meeting server needed; small meetings)
BUILTIN_MEETING_MAX=6
BUILTIN_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# optional relay for networks that block direct connections (coturn with use-auth-secret)
BUILTIN_TURN_URLS=
BUILTIN_TURN_SECRET=
# Shared hosting (no always-on processes): run the queue from the scheduler; cron: * * * * * php artisan schedule:run
QUEUE_VIA_SCHEDULER=false
